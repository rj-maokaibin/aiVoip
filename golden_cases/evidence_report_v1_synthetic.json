          {"layer": "RTP_DOWNSTREAM", "available": true, "abnormal": false},
          {"layer": "PCM_RX", "available": true, "abnormal": false}
        ]
      },
      "expected": {
        "finding_types": ["ECHO_PATH_DETECTED"],
        "boundary": {"status": "NO_COMPARABLE_ANOMALY"}
      }
    },
    {
      "id": "boundary-unknown-upstream-missing",
      "input": {
        "packet": {"rtp_streams": [], "anomalies": []},
