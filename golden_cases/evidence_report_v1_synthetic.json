{
  "schema_version": "evidence-report-golden-dataset-v1",
  "description": "Software-only deterministic regression set. Expected labels are kept outside input and never passed to analyzers/composers. Every frozen Q92 P0 Finding type has at least one labelled synthetic case. PR2 audio candidates follow CandidateDecision authority: detector-only PCM candidates are fail-closed; Click/Pop and Unexpected Silence Findings require PROMOTED decisions. Production accuracy still requires Lab Real + Field Confirmed data.",
  "cases": [
    {
      "id": "packet-core-p0",
      "input": {
        "packet": {
          "rtp_streams": [
            {"stream_id": "rtp-core", "src_ip": "10.0.0.1", "src_port": 10000, "dst_ip": "10.0.0.2", "dst_port": 20000, "packet_count": 100, "lost_packets": 1, "loss_rate": 0.01, "codec": "PCMU", "ptime_ms": 20, "p95_jitter_ms": 8.0, "max_delta_ms": 80.0}
          ],
          "anomalies": [
            {"type": "SIP_REGISTRATION_FAILED", "severity": "HIGH", "start_time": 0.2, "evidence": {"status_code": 403}},
            {"type": "SIP_CALL_FAILED", "severity": "HIGH", "start_time": 0.4, "evidence": {"call_id": "call-1", "status_code": 503}},
            {"type": "CODEC_NEGOTIATION_MISMATCH", "severity": "MEDIUM", "start_time": 0.6, "evidence": {"call_id": "call-1", "negotiated_codec": "PCMU", "observed_codec": "PCMA"}},
            {"type": "ONE_WAY_RTP_MEDIA", "severity": "HIGH", "start_time": 0.8, "evidence": {"call_id": "call-1", "stream_id": "rtp-core"}},
            {"type": "PACKET_LOSS", "severity": "MEDIUM", "start_time": 1.0, "evidence": {"stream_id": "rtp-core", "lost_packets": 1, "previous_frame_number": 50, "next_frame_number": 51}},
            {"type": "HIGH_DELTA", "severity": "MEDIUM", "start_time": 1.2, "evidence": {"stream_id": "rtp-core", "delta_ms": 80.0, "previous_frame_number": 60, "current_frame_number": 61}}
          ]
        }
      },
      "expected": {
        "finding_types": [
          "SIP_REGISTRATION_FAILED",
          "SIP_CALL_FAILED",
          "CODEC_NEGOTIATION_MISMATCH",
          "ONE_WAY_RTP_MEDIA",
          "PACKET_LOSS",
          "HIGH_DELTA"
        ]
      }
    },
    {
      "id": "packet-burst-loss",
      "input": {
        "packet": {
          "rtp_streams": [{"stream_id": "rtp-1", "src_ip": "10.0.0.1", "src_port": 10000, "dst_ip": "10.0.0.2", "dst_port": 20000, "packet_count": 100, "lost_packets": 3, "loss_rate": 0.03, "codec": "PCMU", "ptime_ms": 20}],
          "anomalies": [{"type": "BURST_LOSS", "severity": "HIGH", "start_time": 1.2, "evidence": {"stream_id": "rtp-1", "lost_packets": 3, "previous_frame_number": 100, "next_frame_number": 101}}]
        },
        "layer_observations": [
          {"layer": "RTP_DOWNSTREAM", "available": true, "abnormal": true},
          {"layer": "PCM_RX", "available": true, "abnormal": true}
        ]
      },
      "expected": {
        "finding_types": ["BURST_LOSS"],
        "boundary": {"status": "OBSERVED_BOUNDARY", "first_observable_layer": "RTP_DOWNSTREAM"}
      }
    },
    {
      "id": "pcm-rx-hum",
      "input": {
        "pcm": {
          "streams": [{
            "tap": {"name": "pcm_rx", "direction": "RX"},
            "sessions": [{"session_index": 0, "start_time": 2.0, "end_time": 5.0, "hum": {"level": "HIGH", "dominant_family": "50Hz", "score": 0.92}, "signal": {"rms_dbfs": -21.4, "peak_dbfs": -5.8}, "gap_events": [], "silence_events": [], "click_pop_events": [], "dtmf_quality_events": []}]
