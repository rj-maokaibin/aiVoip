# Development-only template. Copy to .env and replace placeholders locally.
# Do not reuse these values for production; use deploy/production.env.example.
APP_ENV=development
APP_VERSION=local
BUILD_REVISION=workspace
DATABASE_URL=postgresql+psycopg://voip:<dev-postgres-password>@postgres:5432/voip
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<dev-minio-access-key>
MINIO_SECRET_KEY=<dev-minio-secret-key>
MINIO_BUCKET=voip-evidence
MINIO_SECURE=false
MINIO_ACCESS_KEY_FILE=
MINIO_SECRET_KEY_FILE=

AUTH_ALLOW_ANONYMOUS_DEV=true
PRODUCTION_AUTH_PROVIDER=pending
AUTH_GATEWAY_HMAC_SECRET_FILE=
CORS_ALLOW_ORIGINS=*

CREDENTIAL_PROVIDER=mock
CREDENTIAL_API_URL=
CREDENTIAL_API_TOKEN_FILE=
REPRODUCTION_PLATFORM_MODE=mock
REPRODUCTION_STORAGE_MODE=local

FEISHU_LIVE_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET_FILE=
FEISHU_VERIFICATION_TOKEN_FILE=
FEISHU_DEFAULT_RECEIVE_ID=

AI_SHADOW_ENABLED=false
REASONING_GATEWAY_URL=
REASONING_GATEWAY_TOKEN=
REASONING_GATEWAY_MODEL=
REASONING_GATEWAY_MODELS=
REASONING_GATEWAY_FAILOVER_ENABLED=true
AI_EVAL_MIN_SAMPLES=10
