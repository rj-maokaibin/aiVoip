# VOIP AI V1.0 production deployment template.
# Copy to an untracked file such as /etc/voip-ai/production.env, chmod 600,
# replace every <...> placeholder, and keep secrets in separate 600-mode files.

APP_ENV=production
APP_VERSION=1.0.0
BUILD_REVISION=<immutable-git-sha-or-build-id>
AUTH_ALLOW_ANONYMOUS_DEV=false
PRODUCTION_AUTH_PROVIDER=gateway_hmac
AUTH_GATEWAY_HMAC_SECRET_FILE=/run/secrets/auth_gateway_hmac
CORS_ALLOW_ORIGINS=https://voip-ai.example.internal

# Host/network bindings.
VOIP_FRONTEND_BIND=0.0.0.0
VOIP_FRONTEND_PORT=8080
VOIP_BACKEND_BIND=127.0.0.1
VOIP_BACKEND_PORT=8000
VITE_API_BASE_URL=/api/v1

# Persistent service bootstrap credentials. These values live only in the protected
# deployment env file; do not commit them.
POSTGRES_PASSWORD=<strong-postgres-password>
DATABASE_URL=postgresql+psycopg://voip:<strong-postgres-password>@postgres:5432/voip
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=<strong-minio-root-user>
MINIO_ROOT_PASSWORD=<strong-minio-root-password>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
MINIO_BUCKET=voip-evidence
MINIO_SECURE=false
REPRODUCTION_STORAGE_MODE=minio

# DUT credential provider. Production never stores DUT passwords locally.
CREDENTIAL_PROVIDER=api
CREDENTIAL_API_URL=https://credential-service.example.internal/v1/device-password
CREDENTIAL_API_TOKEN_FILE=/run/secrets/credential_api_token
SSH_USERNAME=admin

# EC-02 real platform is promoted (2026-08-14): RUIJIE_VOIP_AIM_V1 is VERIFIED and
# production-ready for AUTONOMOUS_REPRODUCTION; RealReproductionPlatform binds the
# abstract actions to real DUT commands. Production must run with the real platform,
# not the mock.
REPRODUCTION_PLATFORM_MODE=real

# Feishu live transport.
FEISHU_LIVE_ENABLED=true
FEISHU_APP_ID=<app-id>
FEISHU_APP_SECRET_FILE=/run/secrets/feishu_app_secret
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_DEFAULT_RECEIVE_ID=<chat-id>
FEISHU_VERIFICATION_TOKEN_FILE=/run/secrets/feishu_verification_token

# Host paths for Docker Compose secrets. These paths are read by Docker Compose,
# not by the application container.
AUTH_GATEWAY_HMAC_SECRET_HOST_FILE=/etc/voip-ai/secrets/auth_gateway_hmac
MINIO_ACCESS_KEY_SECRET_HOST_FILE=/etc/voip-ai/secrets/minio_access_key
MINIO_SECRET_KEY_SECRET_HOST_FILE=/etc/voip-ai/secrets/minio_secret_key
CREDENTIAL_API_TOKEN_SECRET_HOST_FILE=/etc/voip-ai/secrets/credential_api_token
FEISHU_APP_SECRET_HOST_FILE=/etc/voip-ai/secrets/feishu_app_secret
FEISHU_VERIFICATION_TOKEN_HOST_FILE=/etc/voip-ai/secrets/feishu_verification_token

# Deployment runner policy. All are configurable; these are release defaults.
VOIP_DATA_ROOT=/data/voip
VOIP_MIN_FREE_GB=20
VOIP_HEALTH_TIMEOUT_SECONDS=180
VOIP_PROJECT_NAME=voip-ai
