#!/usr/bin/env bash
set -Eeuo pipefail
# Production deploy runs under sudo; prevent read-only Git checks from refreshing
# the index as root and polluting the self-hosted runner workspace.
export GIT_OPTIONAL_LOCKS=0

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_ENV="${VOIP_ENV_FILE:-/etc/voip-ai/production.env}"
ENV_FILE="$DEFAULT_ENV"
BASE_ENV_FILE="$DEFAULT_ENV"
RUNTIME_ENV_FILE=""
RUNTIME_ENV_READY=0
TARGET_REVISION=""
# Compose project name. Last-resort default is the production stack name
# (aivoip); the authoritative value is resolved from the production env file
# (VOIP_PROJECT_NAME) after --env is parsed, unless --project is given on the
# CLI. This prevents an accidental plain invocation from creating a second,
# unrelated stack.
PROJECT="aivoip"
PROJECT_FROM_CLI=0
FIELD_PCAP=""
KEEP_STACK=0
SKIP_BACKUP=0

usage() {
  cat <<'USAGE'
VOIP AI V1.0 production deployment CLI

Usage:
  deploy/voip-ai [global options] <command>

Global options:
  --env FILE          Persistent production env file (default: /etc/voip-ai/production.env)
  --revision SHA      Immutable deployment revision (default: current Git HEAD; must equal HEAD)
  --project NAME      Docker Compose project name (default: aivoip; env VOIP_PROJECT_NAME wins)
  --field-pcap FILE   Field PCAP used by release verification
  --keep-stack        Keep E2E stack on failure
  --skip-backup       Skip automatic PostgreSQL backup before deploy/upgrade

Commands:
  preflight           Validate host, production env, secrets and release prerequisites
  prepare-host        Create persistent data/backup directories
  build               Build immutable application images
  deploy              Preflight, backup, migrate, start production stack and verify runtime
  verify              Verify live production stack, including exactly one Feishu consumer
  release             Deploy + Docker full-stack E2E + strict V1.0 release gate
  status              Show Compose status, application health and Feishu consumer health
  logs                Follow backend, worker and Feishu long-connection logs
  backup-db           Create a compressed PostgreSQL logical backup
  down                 Stop application containers without deleting volumes/data
  help                 Show this help

The release command is intentionally fail-closed. While EC-02 is pending or frontend
package-lock/runtime evidence is missing, it exits non-zero instead of converting blockers to PASS.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env) ENV_FILE="$2"; BASE_ENV_FILE="$2"; shift 2 ;;
    --revision) TARGET_REVISION="$2"; shift 2 ;;
    --project) PROJECT="$2"; PROJECT_FROM_CLI=1; shift 2 ;;
    --field-pcap) FIELD_PCAP="$2"; shift 2 ;;
    --keep-stack) KEEP_STACK=1; shift ;;
    --skip-backup) SKIP_BACKUP=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) COMMAND="$1"; shift; break ;;
  esac
done
COMMAND="${COMMAND:-help}"

cd "$ROOT"
BASE_ENV_FILE="$(python3 - "$BASE_ENV_FILE" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).expanduser().resolve())
PY
)"
ENV_FILE="$BASE_ENV_FILE"

cleanup_runtime_env() {
  if [[ -n "$RUNTIME_ENV_FILE" ]]; then
    rm -f "$RUNTIME_ENV_FILE"
  fi
}
trap cleanup_runtime_env EXIT

materialize_runtime_env() {
  local security_mode="${1:-strict}"
  if [[ "$RUNTIME_ENV_READY" == "1" ]]; then
    return 0
  fi

  local head revision
  head="$(git rev-parse HEAD 2>/dev/null || true)"
  if [[ ! "$head" =~ ^[0-9a-f]{40}$ ]]; then
    echo "ERROR: unable to resolve immutable Git HEAD for runtime BUILD_REVISION" >&2
    return 2
  fi
  revision="${TARGET_REVISION:-$head}"
  if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
    echo "ERROR: --revision must be an immutable 40-char lowercase git SHA; observed=${revision:-missing}" >&2
    return 2
  fi
  if [[ "$revision" != "$head" ]]; then
    echo "ERROR: requested revision does not match checked-out source: requested=$revision git_head=$head" >&2
    return 2
  fi

  RUNTIME_ENV_FILE="$(mktemp "${TMPDIR:-/tmp}/voip-ai-runtime-env.XXXXXX")"
  local -a runtime_env_args=(
    --base-env "$BASE_ENV_FILE"
    --revision "$revision"
    --out "$RUNTIME_ENV_FILE"
  )
  if [[ "$security_mode" == "relaxed" ]]; then
    runtime_env_args+=(--allow-insecure-base)
  fi
  if ! python3 deploy/runtime_env.py "${runtime_env_args[@]}"; then
    rm -f "$RUNTIME_ENV_FILE"
    RUNTIME_ENV_FILE=""
    return 2
  fi
  ENV_FILE="$RUNTIME_ENV_FILE"
  TARGET_REVISION="$revision"
  RUNTIME_ENV_READY=1
  echo "BUILD_REVISION_SOURCE=RUNTIME revision=$revision base_env=$BASE_ENV_FILE persistent_env_mutated=false"
}

compose() {
  materialize_runtime_env relaxed
  DOCKER_BUILDKIT="${DOCKER_BUILDKIT:-1}" COMPOSE_DOCKER_CLI_BUILD="${COMPOSE_DOCKER_CLI_BUILD:-1}" \
    VOIP_APP_ENV_FILE="$ENV_FILE" docker compose \
    --project-name "$PROJECT" \
    --env-file "$ENV_FILE" \
    -f docker-compose.yml -f docker-compose.production.yml "$@"
}

env_value() {
  python3 - "$ENV_FILE" "$1" <<'PY'
from pathlib import Path
import sys
path=Path(sys.argv[1]); key=sys.argv[2]
for raw in path.read_text(encoding='utf-8').splitlines():
    line=raw.strip()
    if not line or line.startswith('#') or '=' not in line: continue
    if line.startswith('export '): line=line[7:].strip()
    k,v=line.split('=',1)
    if k.strip()!=key: continue
    v=v.strip()
    if len(v)>=2 and v[0]==v[-1] and v[0] in {'"',"'"}: v=v[1:-1]
    print(v); raise SystemExit(0)
raise SystemExit(1)
PY
}

# Resolve the compose project name: CLI --project wins, otherwise the value in
# the production env file (VOIP_PROJECT_NAME) is authoritative, falling back to
# the production stack name (aivoip).
if [[ "$PROJECT_FROM_CLI" != "1" ]]; then
  ENV_FILE="$BASE_ENV_FILE"
  PROJECT="$(env_value VOIP_PROJECT_NAME 2>/dev/null || printf '%s' "$PROJECT")"
fi

# CICD_PERFORMANCE_V2_EVIDENCE: timing is evidence-only; every existing gate remains fail-closed.
PERF_TIMING_LOG=""
PERF_EVIDENCE="${VOIP_CICD_PERF_EVIDENCE:-validation/cicd_performance_v2.json}"

perf_reset() {
  mkdir -p validation
  PERF_TIMING_LOG="$(mktemp)"
  : > "$PERF_TIMING_LOG"
}

perf_write_timing() {
  local revision
  revision="$(env_value BUILD_REVISION 2>/dev/null || echo unknown)"
  python3 - "$PERF_TIMING_LOG" "$PERF_EVIDENCE" "$revision" <<'PYTIMING'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

log_path = Path(sys.argv[1])
out_path = Path(sys.argv[2])
revision = sys.argv[3]
phases = []
for raw in log_path.read_text(encoding="utf-8").splitlines():
    if not raw.strip():
        continue
    name, status, duration_ms = raw.split("\t", 2)
    phases.append({"phase": name, "status": status, "duration_ms": int(duration_ms)})
payload = {
    "schema_version": "cicd-performance-v2",
    "created_at": datetime.now(timezone.utc).isoformat(),
    "build_revision": revision,
    "status": "PASS" if phases and all(x["status"] == "PASS" for x in phases) else "FAIL",
    "total_duration_ms": sum(x["duration_ms"] for x in phases),
    "phases": phases,
}
out_path.parent.mkdir(parents=True, exist_ok=True)
out_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
print(f"CICD_PERFORMANCE_V2_EVIDENCE={out_path} total_ms={payload['total_duration_ms']} status={payload['status']}")
PYTIMING
}

perf_phase() {
  local name="$1" start_ns end_ns duration_ms rc status
  shift
  start_ns="$(date +%s%N)"
  if "$@"; then
    rc=0
    status=PASS
  else
    rc=$?
    status=FAIL
  fi
  end_ns="$(date +%s%N)"
  duration_ms="$(( (end_ns - start_ns) / 1000000 ))"
  printf '%s\t%s\t%s\n' "$name" "$status" "$duration_ms" >> "$PERF_TIMING_LOG"
  perf_write_timing
  echo "PERF_PHASE name=$name status=$status duration_ms=$duration_ms"
  return "$rc"
}

require_docker() {
  local err rc
  command -v docker >/dev/null 2>&1 || { echo "ERROR: docker CLI is required (not found in PATH)" >&2; exit 127; }
  docker compose version >/dev/null 2>&1 || { echo "ERROR: docker compose plugin is required" >&2; exit 127; }
  err="$(docker info 2>&1 >/dev/null)" || rc=$?
  if [[ "${rc:-0}" == "0" ]]; then
    return 0
  fi
  case "$err" in
    *"permission denied"*)
      echo "ERROR: Docker permission denied (the docker socket is not accessible to this user)" >&2
      echo "  hint: add the user to the docker group and refresh the session, e.g." >&2
      echo "  sudo usermod -aG docker \"\$USER\" && newgrp docker   (or: sg docker -c '<command>')" >&2
      exit 126 ;;
    *"Cannot connect to the Docker daemon"*|*"Is the docker daemon running"*|*"no such file or directory"*|*"connection refused"*)
      echo "ERROR: Docker daemon is not reachable (is dockerd running?)" >&2
      exit 126 ;;
    *"current context"*|*"context"*)
      echo "ERROR: Docker context is invalid: '$(docker context show 2>/dev/null || echo unknown)'" >&2
      exit 126 ;;
    *)
      echo "ERROR: Docker daemon is not reachable: $(printf '%s' "$err" | head -1)" >&2
      exit 126 ;;
  esac
}

source_binding_preflight() {
  materialize_runtime_env || return $?
  local expected head dirty
  expected="$(env_value BUILD_REVISION 2>/dev/null || true)"
  head="$(git rev-parse HEAD 2>/dev/null || true)"
  dirty="$(git status --porcelain --untracked-files=no 2>/dev/null || true)"
  if [[ ! "$expected" =~ ^[0-9a-f]{40}$ ]]; then
    echo "ERROR: BUILD_REVISION must be an immutable 40-char git SHA; observed=${expected:-missing}" >&2
    return 1
  fi
  if [[ "$head" != "$expected" ]]; then
    echo "ERROR: exact source binding failed before deploy: git_head=$head BUILD_REVISION=$expected" >&2
    return 1
  fi
  if [[ -n "$dirty" ]]; then
    echo "ERROR: tracked production source is dirty; refusing deployment" >&2
    printf '%s\n' "$dirty" >&2
    return 1
  fi
  mkdir -p validation
  python3 tools/source_manifest_gate.py
  python3 deploy/exact_source_binding_gate.py \
    --env-file "$ENV_FILE" \
    --phase source \
    --out validation/exact_source_binding_source_result.json
  echo "EXACT_SOURCE_PREDEPLOY_GATE=PASS revision=$expected"
}

host_preflight() {
  require_docker
  materialize_runtime_env || return $?
  [[ -f "$ENV_FILE" ]] || { echo "ERROR: effective production env file missing: $ENV_FILE" >&2; exit 2; }
  source_binding_preflight
  mkdir -p validation
  python3 deploy/deployment_preflight.py --env-file "$ENV_FILE" --mode deploy --out validation/phase_f3_deployment_preflight.json
  # Repair an existing Docker bridge route hijack without stopping the live stack.
  python3 deploy/docker_network_guard.py prepare --project "$PROJECT"
  compose config >/dev/null
  echo "Docker/Compose configuration: PASS"
}

prepare_host() {
  materialize_runtime_env relaxed || return $?
  local root min_gb
  root="$(env_value VOIP_DATA_ROOT 2>/dev/null || echo /data/voip)"
  min_gb="$(env_value VOIP_MIN_FREE_GB 2>/dev/null || echo 20)"
  if [[ $EUID -ne 0 && ! -w "$(dirname "$root")" ]]; then
    echo "ERROR: $root requires elevated permission. Run prepare-host with sudo or pre-create it." >&2
    exit 2
  fi
  mkdir -p "$root"/{postgres,redis,minio,reproduction/capture,reproduction/objects,backups,release}
  chmod 0750 "$root" "$root/backups" "$root/release" || true
  local avail
  avail="$(df -Pk "$root" | awk 'NR==2 {print int($4/1024/1024)}')"
  if (( avail < min_gb )); then
    echo "ERROR: only ${avail} GiB free under $root; VOIP_MIN_FREE_GB=${min_gb}" >&2
    exit 2
  fi
  echo "Host directories ready: $root (${avail} GiB free)"
}

backup_db() {
  require_docker
  materialize_runtime_env relaxed || return $?
  local data_root ts out
  data_root="$(env_value VOIP_DATA_ROOT 2>/dev/null || echo /data/voip)"
  mkdir -p "$data_root/backups"
  if ! compose ps --status running --services 2>/dev/null | grep -qx postgres; then
    echo "PostgreSQL is not running; no existing DB backup required."
    return 0
  fi
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$data_root/backups/voip-${ts}.sql.gz"
  compose exec -T postgres pg_dump -U voip -d voip | gzip -9 > "$out"
  test -s "$out"
  chmod 0600 "$out" || true
  echo "Database backup: $out"
}

build_images() {
  if [[ "${1:-}" != "--preflight-done" ]]; then
    host_preflight
  fi
  echo "Building production images for source manifest:"
  python3 tools/source_manifest_gate.py
  local services=(backend frontend)
  local data_root release_root build_log audit_file rc
  data_root="$(env_value VOIP_DATA_ROOT 2>/dev/null || echo /data/voip)"
  release_root="$data_root/release"
  build_log="$release_root/docker-build-pull.log"
  audit_file="${VOIP_OFFLINE_BUILD_AUDIT:-$release_root/offline-build-fallback.json}"
  mkdir -p "$release_root"

  # V2.1: prove registry DNS/TCP/HTTP transport quickly. A full docker pull is
  # intentionally not used as a preflight because the corporate Nexus mirror can
  # legitimately take tens of seconds before layer transfer begins. The actual
  # online freshness check remains compose build --pull below.
  local probe_log probe_json probe_timeout probe_rc
  probe_log="$release_root/registry-probe.log"
  probe_json="${VOIP_REGISTRY_PROBE_EVIDENCE:-validation/registry_connectivity_v2_1.json}"
  probe_timeout="${VOIP_REGISTRY_PROBE_TIMEOUT_SECONDS:-3}"
  set +e
  python3 deploy/registry_connectivity_probe.py     --timeout-seconds "$probe_timeout"     --out "$probe_json" >"$probe_log" 2>&1
  probe_rc="$?"
  set -e
  cat "$probe_log"
  if [[ "$probe_rc" != "0" ]]; then
    echo "REGISTRY_PREFLIGHT=FAIL; evaluating audited offline fallback immediately..."
    if python3 deploy/offline_build_fallback.py         --build-log "$probe_log"         --online-exit-code "$probe_rc"         --audit "$audit_file"; then
      echo "OFFLINE_IMAGE_FALLBACK=AUTHORIZED source=REGISTRY_PREFLIGHT audit=$audit_file"
      local offline_rc
      set +e
      BUILDKIT_PROGRESS="${BUILDKIT_PROGRESS:-plain}" compose build --pull=false --build-arg "BUILD_REVISION=$(env_value BUILD_REVISION)" "${services[@]}"
      offline_rc="$?"
      set -e
      if [[ "$offline_rc" != "0" ]]; then
        echo "PRODUCTION_IMAGE_BUILD=FAIL mode=OFFLINE_LOCAL_INVENTORY source=REGISTRY_PREFLIGHT exit_code=$offline_rc audit=$audit_file" >&2
        return "$offline_rc"
      fi
      echo "PRODUCTION_IMAGE_BUILD=PASS mode=OFFLINE_LOCAL_INVENTORY audit=$audit_file"
      return 0
    fi
    echo "PRODUCTION_IMAGE_BUILD=BLOCKED reason=REGISTRY_PREFLIGHT online_exit_code=$probe_rc audit=$audit_file" >&2
    return "$probe_rc"
  fi
  echo "REGISTRY_PREFLIGHT=PASS mode=HTTP_CONNECTIVITY evidence=$probe_json"

  # Online pull is always preferred. Offline fallback is allowed only for a
  # proven registry transport failure with a complete local image inventory.
  set +e
  BUILDKIT_PROGRESS="${BUILDKIT_PROGRESS:-plain}" compose build --pull --build-arg "BUILD_REVISION=$(env_value BUILD_REVISION)" "${services[@]}" 2>&1 | tee "$build_log"
  rc="${PIPESTATUS[0]}"
  set -e
  if [[ "$rc" == "0" ]]; then
    echo "PRODUCTION_IMAGE_BUILD=PASS mode=ONLINE_PULL"
    return 0
  fi

  echo "Online image build failed; evaluating fail-closed offline eligibility..."
  if ! python3 deploy/offline_build_fallback.py \
      --build-log "$build_log" \
      --online-exit-code "$rc" \
      --audit "$audit_file"; then
    echo "PRODUCTION_IMAGE_BUILD=BLOCKED online_exit_code=$rc audit=$audit_file" >&2
    return "$rc"
  fi

  echo "OFFLINE_IMAGE_FALLBACK=AUTHORIZED audit=$audit_file"
  local offline_rc
  set +e
  BUILDKIT_PROGRESS="${BUILDKIT_PROGRESS:-plain}" compose build --pull=false --build-arg "BUILD_REVISION=$(env_value BUILD_REVISION)" "${services[@]}"
  offline_rc="$?"
  set -e
  if [[ "$offline_rc" != "0" ]]; then
    echo "PRODUCTION_IMAGE_BUILD=FAIL mode=OFFLINE_LOCAL_INVENTORY source=POSTBUILD_FALLBACK exit_code=$offline_rc audit=$audit_file" >&2
    return "$offline_rc"
  fi
  echo "PRODUCTION_IMAGE_BUILD=PASS mode=OFFLINE_LOCAL_INVENTORY audit=$audit_file"
  return 0
}

wait_http() {
  local url="$1" timeout="${2:-180}" start now
  start="$(date +%s)"
  until curl -fsS "$url" >/dev/null 2>&1; do
    now="$(date +%s)"
    if (( now - start >= timeout )); then
      echo "ERROR: timeout waiting for $url" >&2
      return 1
    fi
    sleep 2
  done
}

wait_feishu_long_connection() {
  local timeout="${1:-180}" start now cid state
  start="$(date +%s)"
  while true; do
    cid="$(compose ps -q feishu-long-connection 2>/dev/null || true)"
    if [[ -n "$cid" ]]; then
      state="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || true)"
      if [[ "$state" == "healthy" ]]; then
        return 0
      fi
      if [[ "$state" == "exited" || "$state" == "dead" ]]; then
        echo "ERROR: feishu-long-connection entered terminal state: $state" >&2
        return 1
      fi
    fi
    now="$(date +%s)"
    if (( now - start >= timeout )); then
      echo "ERROR: timeout waiting for feishu-long-connection health (last_state=${state:-missing})" >&2
      return 1
    fi
    sleep 2
  done
}

verify_feishu_consumer_host() {
  local live expected_revision count cid actual_project actual_revision health
  local -a consumer_ids=()
  live="$(env_value FEISHU_LIVE_ENABLED 2>/dev/null || echo false)"
  case "${live,,}" in
    true|1|yes|on) ;;
    *) echo "FEISHU_LONG_CONNECTION_HOST_GATE=SKIP reason=FEISHU_LIVE_DISABLED"; return 0 ;;
  esac

  mapfile -t consumer_ids < <(docker ps \
    --filter 'label=com.docker.compose.service=feishu-long-connection' \
    --format '{{.ID}}')
  count="${#consumer_ids[@]}"
  if [[ "$count" != "1" ]]; then
    echo "ERROR: expected exactly one Feishu long-connection consumer; observed=$count" >&2
    return 1
  fi

  cid="${consumer_ids[0]}"
  actual_project="$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$cid")"
  if [[ "$actual_project" != "$PROJECT" ]]; then
    echo "ERROR: Feishu consumer belongs to compose project '$actual_project', expected '$PROJECT'" >&2
    return 1
  fi

  expected_revision="$(env_value BUILD_REVISION 2>/dev/null || true)"
  if [[ -z "$expected_revision" ]]; then
    echo "ERROR: BUILD_REVISION is not configured" >&2
    return 1
  fi
  actual_revision="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" | awk -F= '$1=="BUILD_REVISION" {print substr($0,index($0,"=")+1); exit}')"
  if [[ "$actual_revision" != "$expected_revision" ]]; then
    echo "ERROR: Feishu consumer build revision mismatch actual=$actual_revision expected=$expected_revision" >&2
    return 1
  fi

  health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid")"
  if [[ "$health" != "healthy" ]]; then
    echo "ERROR: Feishu consumer is not healthy: $health" >&2
    return 1
  fi

  mkdir -p validation
  python3 - "$PROJECT" "$expected_revision" "$cid" "$health" <<'PY'
import hashlib
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / 'tools'))
from release_evidence import evidence_envelope
project, revision, container_id, health = sys.argv[1:]
payload = evidence_envelope(
    evidence_type='FEISHU_LONG_CONNECTION_RUNTIME',
    payload={
        'passed': True,
        'service': 'feishu-long-connection',
        'compose_project': project,
        'build_revision': revision,
        'consumer_count': 1,
        'container_id_sha256': hashlib.sha256(container_id.encode()).hexdigest(),
        'health': health,
    },
)
out = Path('validation/feishu_long_connection_runtime.json')
out.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
PY
  echo "FEISHU_LONG_CONNECTION_HOST_GATE=PASS project=$PROJECT revision=$expected_revision consumer_count=1 health=$health"
}

evidence_v2_rollout_acceptance() {
  local stage expected_revision cid observed_revision result_in_container
  local global_compose global_project global_strict
  stage="$(python3 -c 'import json; from pathlib import Path; p=json.loads(Path("deploy/evidence_v2_rollout.json").read_text(encoding="utf-8")); s=str(p.get("stage") or "").upper(); assert s in {"SHADOW","CANARY","DEFAULT"}; print(s)')"
  expected_revision="$(env_value BUILD_REVISION)"
  cid="$(compose ps -q backend)"
  [[ -n "$cid" ]] || { echo "ERROR: production backend container missing for Evidence V2 acceptance" >&2; return 1; }
  observed_revision="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" | awk -F= '$1=="BUILD_REVISION" {print substr($0,index($0,"=")+1); exit}')"
  [[ "$observed_revision" == "$expected_revision" ]] || { echo "ERROR: Evidence V2 backend revision mismatch actual=$observed_revision expected=$expected_revision" >&2; return 1; }
  global_compose="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" | awk -F= '$1=="PRELIMINARY_EVIDENCE_V2_COMPOSE" {print tolower($2); exit}')"
  global_project="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" | awk -F= '$1=="PRELIMINARY_EVIDENCE_V2_PROJECT" {print tolower($2); exit}')"
  global_strict="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid" | awk -F= '$1=="PRELIMINARY_EVIDENCE_V2_STRICT_VALIDATOR" {print tolower($2); exit}')"
  [[ "$global_compose" == "true" && "$global_strict" == "true" ]] || { echo "ERROR: Evidence V2 production compose/strict defaults not active" >&2; return 1; }
  if [[ "$stage" == "DEFAULT" ]]; then
    [[ "$global_project" == "true" ]] || { echo "ERROR: Evidence V2 DEFAULT requires global V2 projection" >&2; return 1; }
  else
    [[ "$global_project" == "false" ]] || { echo "ERROR: Evidence V2 SHADOW/CANARY must keep global V1 projection" >&2; return 1; }
  fi

  mkdir -p validation
  rm -f validation/evidence_v2_production_acceptance.json
  result_in_container=/tmp/evidence-v2-production-acceptance.json
  if [[ "$stage" == "CANARY" ]]; then
    docker exec \
      -e PRELIMINARY_EVIDENCE_V2_COMPOSE=true \
      -e PRELIMINARY_EVIDENCE_V2_PROJECT=true \
      -e PRELIMINARY_EVIDENCE_V2_STRICT_VALIDATOR=true \
      "$cid" python /tools/evidence_v2_production_acceptance.py \
      --stage "$stage" --expected-revision "$expected_revision" --result "$result_in_container" || return $?
  else
    docker exec "$cid" python /tools/evidence_v2_production_acceptance.py \
      --stage "$stage" --expected-revision "$expected_revision" --result "$result_in_container" || return $?
  fi
  docker cp "$cid:$result_in_container" validation/evidence_v2_production_acceptance.json >/dev/null
  python3 -c 'import json,sys; from pathlib import Path; stage,revision=sys.argv[1:]; r=json.loads(Path("validation/evidence_v2_production_acceptance.json").read_text(encoding="utf-8")); assert r.get("status")=="PASS",r; assert r.get("stage")==stage,r; assert r.get("source_revision")==revision,r; assert r.get("v2_semantic_status")=="PASS",r; assert r.get("v2_publishable") is True,r; assert (r.get("active_projection")=="V1" and r.get("feishu_projection_attempted") is False) if stage=="SHADOW" else (r.get("active_projection")=="V2" and r.get("canonical_readback")=="PASS" and r.get("document_reused") is True),r; print(f"EVIDENCE_V2_PRODUCTION_{stage}=PASS revision={revision}")' "$stage" "$expected_revision"
}

deploy_stack() {
  if [[ "$(id -u)" == "0" && "$BASE_ENV_FILE" == "/etc/voip-ai/production.env" ]]; then
    python3 deploy/production_wrapper_migration.py \
      --source deploy/production_deploy_wrapper.sh \
      --target /usr/local/sbin/voip-ai-production-deploy \
      --env-file "$BASE_ENV_FILE"
  fi
  perf_reset
  perf_phase preflight host_preflight
  perf_phase prepare_host prepare_host
  if [[ "$SKIP_BACKUP" != "1" ]]; then perf_phase backup_db backup_db; fi
  perf_phase image_build build_images --preflight-done

  echo "Starting PostgreSQL, Redis and MinIO..."
  perf_phase data_services_start compose up -d postgres redis minio
  echo "Applying Alembic migration explicitly before application promotion..."
  perf_phase migration compose run --rm backend alembic upgrade head
  # Keep this stable marker because Capture V2's frozen deploy contract parses the
  # promotion block after it. Feishu is now part of that same managed promotion.
  echo "Starting backend, workers, scheduler and frontend..."
  perf_phase application_promotion compose up -d \
    backend collector-worker packet-worker pcm-worker media-worker diagnosis-worker \
    feishu-long-connection \
    reproduction-worker reproduction-control-high-worker reproduction-watch-worker beat frontend
  # All managed services have now moved to the named safe production network.
  perf_phase network_cleanup python3 deploy/docker_network_guard.py cleanup --project "$PROJECT"

  local timeout backend_port frontend_port
  timeout="$(env_value VOIP_HEALTH_TIMEOUT_SECONDS 2>/dev/null || echo 180)"
  backend_port="$(env_value VOIP_BACKEND_PORT 2>/dev/null || echo 8000)"
  frontend_port="$(env_value VOIP_FRONTEND_PORT 2>/dev/null || echo 8088)"
  perf_phase backend_ready wait_http "http://127.0.0.1:${backend_port}/health/ready" "$timeout"
  perf_phase frontend_ready wait_http "http://127.0.0.1:${frontend_port}/" "$timeout"
  perf_phase feishu_ready wait_feishu_long_connection "$timeout"
  perf_phase runtime_verify verify_stack
  perf_phase evidence_v2_rollout_acceptance evidence_v2_rollout_acceptance
}

verify_stack() {
  require_docker
  materialize_runtime_env relaxed || return $?
  mkdir -p validation
  rm -f validation/feishu_long_connection_runtime.json
  verify_feishu_consumer_host || return $?
  compose run --rm -e PRODUCTION_RUNTIME_EVIDENCE=/workspace/validation/production_runtime_result.json release-runner \
    python deploy/production_runtime_verify.py || return $?
  local backend_port
  backend_port="$(env_value VOIP_BACKEND_PORT 2>/dev/null || echo 8000)"
  python3 deploy/exact_source_binding_gate.py \
    --env-file "$ENV_FILE" \
    --phase runtime \
    --project "$PROJECT" \
    --backend-url "http://127.0.0.1:${backend_port}/health/ready" \
    --runtime-evidence validation/production_runtime_result.json \
    --feishu-evidence validation/feishu_long_connection_runtime.json \
    --out validation/exact_source_binding_result.json || return $?
  echo "Runtime evidence: validation/production_runtime_result.json"
  echo "Exact source binding evidence: validation/exact_source_binding_result.json"
  if [[ -f validation/feishu_long_connection_runtime.json ]]; then
    echo "Feishu runtime evidence: validation/feishu_long_connection_runtime.json"
  fi
}

frontend_docker_gate() {
  require_docker
  [[ -f frontend/package-lock.json ]] || { echo "ERROR: frontend/package-lock.json missing" >&2; return 3; }
  local tag tmp cid
  tag="voip-ai-frontend-release:${PROJECT}-$(python3 - <<'PY'
import json
from pathlib import Path
print(json.loads(Path('release/source_manifest.json').read_text())['aggregate_sha256'][:12])
PY
)"
  docker build -t "$tag" --build-arg VITE_API_BASE_URL=/api/v1 frontend
  tmp="$(mktemp -d)"
  cid="$(docker create "$tag")"
  trap 'docker rm -f "$cid" >/dev/null 2>&1 || true; rm -rf "$tmp"' RETURN
  docker cp "$cid:/usr/share/nginx/html/index.html" "$tmp/index.html"
  python3 - "$tmp/index.html" <<'PY'
import hashlib,json,sys
from pathlib import Path
sys.path.insert(0,str(Path.cwd()/'tools'))
from release_evidence import evidence_envelope
p=Path(sys.argv[1])
out=Path('validation/frontend_build_runtime.json')
payload=evidence_envelope(evidence_type='FRONTEND_PRODUCTION_BUILD',payload={
 'passed':True,'build_executor':'docker','lockfile':'frontend/package-lock.json',
 'index_path':'/usr/share/nginx/html/index.html','index_size_bytes':p.stat().st_size,
 'index_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),
})
out.write_text(json.dumps(payload,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
print(json.dumps(payload,ensure_ascii=False,indent=2))
PY
  docker rm -f "$cid" >/dev/null 2>&1 || true
  rm -rf "$tmp"
  trap - RETURN
}

run_fullstack_e2e() {
  require_docker
  if [[ "$KEEP_STACK" == "1" ]]; then export KEEP_E2E_STACK=1; fi
  if [[ -n "$FIELD_PCAP" ]]; then
    FIELD_PCAP="$FIELD_PCAP" ./tools/fullstack_e2e.sh
  else
    ./tools/fullstack_e2e.sh
  fi
}

release_all() {
  # Release preflight is stricter than deploy preflight and intentionally blocks EC-02/mock.
  host_preflight
  python3 deploy/deployment_preflight.py --env-file "$ENV_FILE" --mode release --out validation/phase_f3_release_preflight.json || true
  deploy_stack
  echo "Running exact-source F3 static release gates inside the release-runner image..."
  compose run --rm release-runner sh tools/phase_f3_static_gate.sh
  frontend_docker_gate
  run_fullstack_e2e
  if [[ -n "$FIELD_PCAP" ]]; then
    mkdir -p validation/field-evidence-input
    rm -f validation/field-evidence-input/*
    python3 - "$FIELD_PCAP" <<'PYFIELD'
import hashlib,sys
from pathlib import Path
import yaml
root=Path.cwd(); src=Path(sys.argv[1]).resolve(); digest=hashlib.sha256(src.read_bytes()).hexdigest(); matched=0
for mp in sorted((root/'golden_cases').glob('*/manifest.yaml')):
    m=yaml.safe_load(mp.read_text(encoding='utf-8')) or {}; source=m.get('source') or {}
    if source.get('sha256')==digest and source.get('filename'):
        dst=root/'validation/field-evidence-input'/source['filename']; dst.write_bytes(src.read_bytes()); matched+=1
if matched==0:
    raise SystemExit(f'FIELD_PCAP sha256 {digest} does not match any registered Field Golden manifest')
print(f'staged field evidence for {matched} registered manifest(s): {digest}')
PYFIELD
    compose run --rm release-runner python tools/field_golden_batch.py --evidence-dir /workspace/validation/field-evidence-input --out /workspace/validation/phase_f3_field_golden.json --require-all
  fi
  # Evaluate all exact-source evidence with the exact production environment/secrets.
  compose run --rm release-runner python tools/release_readiness_gate.py --strict \
    ${FIELD_PCAP:+--field-evidence-dir /workspace/validation/field-evidence-input} \
    --out /workspace/validation/phase_f3_release_readiness.json \
    --markdown /workspace/validation/phase_f3_release_readiness.md
}

status_cmd() {
  require_docker
  materialize_runtime_env relaxed || return $?
  compose ps
  local bp fp
  bp="$(env_value VOIP_BACKEND_PORT 2>/dev/null || echo 8000)"
  fp="$(env_value VOIP_FRONTEND_PORT 2>/dev/null || echo 8088)"
  echo
  curl -fsS "http://127.0.0.1:${bp}/health/ready" || true
  echo
  curl -fsSI "http://127.0.0.1:${fp}/" | head || true
  echo
  verify_feishu_consumer_host
}

case "$COMMAND" in
  help) usage ;;
  preflight) host_preflight ;;
  prepare-host) require_docker; prepare_host ;;
  build) build_images ;;
  deploy) deploy_stack ;;
  verify) verify_stack ;;
  release) release_all ;;
  status) status_cmd ;;
  logs) require_docker; compose logs -f \
    backend collector-worker packet-worker pcm-worker media-worker diagnosis-worker \
    feishu-long-connection \
    reproduction-worker reproduction-control-high-worker reproduction-watch-worker beat ;;
  backup-db) backup_db ;;
  down) require_docker; compose down --remove-orphans ;;
  *) echo "ERROR: unknown command: $COMMAND" >&2; usage >&2; exit 2 ;;
esac
